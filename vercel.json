{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/msfwr run build",
  "outputDirectory": "artifacts/msfwr/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://msfwr-relay.onrender.com/api/:path*" },
    { "source": "/((?!api/|assets/|downloads/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ]
}
